PORT=5000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Firebase Admin SDK — paste the entire service account JSON as a single-line string
# Generate at: Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Optional: Realtime Database URL (only needed if using RTDB)
# FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
